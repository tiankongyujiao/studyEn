.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f5f6f7;
  padding-top: 12rpx;
}

.topbar-row {
  display: flex;
  align-items: center;
  margin: 0 24rpx;
}

.searchbar {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.mode-switch {
  flex-shrink: 0;
  display: flex;
  margin-left: 16rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #fff;
  overflow: hidden;
}

.mode-btn {
  padding: 0 24rpx;
  line-height: 80rpx;
  font-size: 24rpx;
  color: #646566;
}

.mode-btn.active {
  background: #323233;
  color: #fff;
}

.view-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 24rpx;
  color: #646566;
}

.view-btn-on {
  color: #07c160;
  font-weight: 600;
}

.group-head {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx 12rpx;
}

.group-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
}

.group-count {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #969799;
}

.group-arrow {
  margin-left: auto;
  color: #c8c9cc;
  font-size: 24rpx;
}

.group-arrow-open {
  display: inline-block;
  transform: rotate(180deg);
}

.drawer-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.drawer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.drawer-label {
  font-size: 24rpx;
  color: #969799;
  margin: 28rpx 0 16rpx;
}

.drawer-hint {
  color: #c8c9cc;
}

.drawer-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -20rpx;
}

.dopt {
  width: calc(50% - 20rpx);
  margin: 0 20rpx 20rpx 0;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: #f5f6f7;
  color: #646566;
  font-size: 26rpx;
  box-sizing: border-box;
}

.dopt-on {
  background: #323233;
  color: #fff;
}

.drawer-done {
  background: #07c160;
  color: #fff;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  margin-top: 8rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
}

.search-clear {
  color: #c8c9cc;
  font-size: 36rpx;
  padding: 0 8rpx;
  line-height: 64rpx;
}

.tabs {
  white-space: nowrap;
  padding: 16rpx 16rpx 4rpx;
  width: 100%;
  box-sizing: border-box;
}

.tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #646566;
  background: #fff;
}

.tab.active {
  background: #323233;
  color: #fff;
}

.tab-count {
  margin-left: 8rpx;
  font-size: 22rpx;
  opacity: 0.75;
}

.list-meta {
  padding: 12rpx 32rpx 4rpx;
  font-size: 24rpx;
  color: #969799;
}

.list {
  padding: 8rpx 24rpx 160rpx;
}

.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 16rpx;
}

.item-hover {
  background: #f7f8f9;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-word-row {
  display: flex;
  align-items: baseline;
}

.item-word {
  font-size: 32rpx;
  font-weight: 600;
  word-break: break-all;
}

.review-badge {
  font-size: 22rpx;
  color: #07c160;
  margin-left: 10rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.item-meaning {
  font-size: 24rpx;
  color: #969799;
  margin-top: 4rpx;
}

.item-meaning-main {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.item-time {
  font-size: 20rpx;
  color: #c8c9cc;
  margin-bottom: 4rpx;
}

.item-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.empty {
  text-align: center;
  color: #969799;
  padding: 120rpx 60rpx;
  font-size: 26rpx;
  line-height: 1.8;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 56rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  z-index: 20;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form {
  width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.form-input {
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.sug {
  white-space: nowrap;
  height: 60rpx;
  margin: -10rpx 0 16rpx;
}

.sug-item {
  display: inline-block;
  padding: 8rpx 22rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #e9f8f0;
  color: #07c160;
  font-size: 26rpx;
}

.form-label {
  font-size: 24rpx;
  color: #969799;
  margin: 8rpx 0 16rpx;
}

.form-actions {
  display: flex;
  margin-top: 36rpx;
}

.form-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #f5f6f7;
  color: #646566;
}

.form-btn-primary {
  background: #07c160;
  color: #fff;
  margin-left: 24rpx;
}
