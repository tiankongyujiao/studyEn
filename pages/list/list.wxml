<view class="page">
  <view class="topbar">
    <view class="topbar-row">
      <view class="searchbar">
        <input class="search-input" placeholder="搜索单词 / 释义" value="{{keyword}}"
               confirm-type="search" bindinput="onSearch" />
        <view class="search-clear" wx:if="{{keyword}}" catchtap="clearSearch">×</view>
      </view>
      <view class="mode-switch">
        <view class="mode-btn {{displayMode === 'en' ? 'active' : ''}}" data-mode="en" bindtap="setDisplayMode">英</view>
        <view class="mode-btn {{displayMode === 'zh' ? 'active' : ''}}" data-mode="zh" bindtap="setDisplayMode">中</view>
        <view class="mode-btn {{displayMode === 'both' ? 'active' : ''}}" data-mode="both" bindtap="setDisplayMode">全</view>
      </view>
      <view class="view-btn {{groupBy || sortMode !== 'time-desc' ? 'view-btn-on' : ''}}" bindtap="openDrawer">排序</view>
    </view>
    <scroll-view scroll-x scroll-with-animation class="tabs">
      <view class="tab {{current === item.id ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="id"
            data-id="{{item.id}}" bindtap="switchTab">
        {{item.name}}<text class="tab-count">{{tabCounts[index]}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="list-meta" wx:if="{{matched > 0}}">
    共 {{matched}} 个单词{{hasMore ? '（上拉加载更多）' : ''}}
  </view>

  <view class="list">
    <block wx:if="{{groupBy}}">
      <view class="group" wx:for="{{groups}}" wx:for-item="g" wx:for-index="gi" wx:key="key">
        <view class="group-head" data-index="{{gi}}" bindtap="toggleGroup">
          <text class="group-label">{{g.label}}</text>
          <text class="group-count">{{g.count}} 词</text>
          <text class="group-arrow {{g.open ? 'group-arrow-open' : ''}}">▾</text>
        </view>
        <block wx:if="{{g.open}}">
          <block wx:for="{{g.items}}" wx:key="_id">
            <template is="word-item" data="{{word: item, displayMode: displayMode}}"/>
          </block>
        </block>
      </view>
    </block>
    <block wx:else>
      <block wx:for="{{items}}" wx:key="_id">
        <template is="word-item" data="{{word: item, displayMode: displayMode}}"/>
      </block>
    </block>
  </view>

  <view class="empty" wx:if="{{matched === 0}}">
    {{keyword ? '没有匹配「' + keyword + '」的单词' : '这个分类还没有单词，点右下角加号添加'}}
  </view>

  <view class="fab" bindtap="onFabTap">＋</view>

  <view class="mask" wx:if="{{showForm}}" bindtap="closeForm">
    <view class="form" catchtap="noop">
      <view class="form-title">{{formTitle}}</view>
      <input class="form-input" placeholder="单词，如 apple" value="{{formWord}}"
             focus="{{wordFocus}}" bindinput="onFormWord" />
      <scroll-view class="sug" scroll-x wx:if="{{suggestions.length}}">
        <view class="sug-item" wx:for="{{suggestions}}" wx:key="*this"
              data-word="{{item}}" bindtap="pickSuggestion">{{item}}</view>
      </scroll-view>
      <input class="form-input" placeholder="中文释义（可选），如 苹果" value="{{formMeaning}}"
             bindinput="onFormMeaning" />
      <view class="form-label">分类（点选）</view>
      <view class="chips">
        <view class="chip" wx:for="{{levels}}" wx:key="id" data-level="{{item.id}}" bindtap="pickFormLevel"
              style="{{formLevel === item.id ? 'background:' + item.color + ';border-color:' + item.color + ';color:#fff' : 'color:' + item.color + ';border-color:' + item.color}}">{{item.name}}</view>
      </view>
      <view class="form-actions">
        <view class="form-btn" bindtap="closeForm">取消</view>
        <view class="form-btn form-btn-primary" bindtap="submitForm">保存</view>
      </view>
    </view>
  </view>

  <view class="drawer-mask" wx:if="{{showDrawer}}" bindtap="closeDrawer">
    <view class="drawer" catchtap="noop">
      <view class="drawer-title">排序与分组</view>
      <view class="drawer-label">排序</view>
      <view class="drawer-grid">
        <view class="dopt {{sortMode === 'time-desc' ? 'dopt-on' : ''}}" data-value="time-desc" bindtap="pickSort">最新录入在前</view>
        <view class="dopt {{sortMode === 'time-asc' ? 'dopt-on' : ''}}" data-value="time-asc" bindtap="pickSort">最早录入在前</view>
        <view class="dopt {{sortMode === 'count-desc' ? 'dopt-on' : ''}}" data-value="count-desc" bindtap="pickSort">复习最多在前</view>
        <view class="dopt {{sortMode === 'count-asc' ? 'dopt-on' : ''}}" data-value="count-asc" bindtap="pickSort">复习最少在前</view>
      </view>
      <view class="drawer-label">分组<text class="drawer-hint">（不选即平铺）</text></view>
      <view class="drawer-grid">
        <view class="dopt {{groupBy === 'day' ? 'dopt-on' : ''}}" data-value="day" bindtap="pickGroup">按天</view>
        <view class="dopt {{groupBy === 'month' ? 'dopt-on' : ''}}" data-value="month" bindtap="pickGroup">按月</view>
        <view class="dopt {{groupBy === 'year' ? 'dopt-on' : ''}}" data-value="year" bindtap="pickGroup">按年</view>
        <view class="dopt {{expandAll ? 'dopt-on' : ''}}" bindtap="toggleExpandAll">{{expandAll ? '已全部展开' : '全部展开'}}</view>
      </view>
      <view class="drawer-done" bindtap="closeDrawer">完成</view>
    </view>
  </view>
</view>

<template name="word-item">
  <view class="item" hover-class="item-hover" data-id="{{word._id}}" bindtap="onItemTap">
    <view class="item-main">
      <view class="item-word-row" wx:if="{{displayMode !== 'zh'}}">
        <text class="item-word">{{word.word}}</text>
        <text class="review-badge" wx:if="{{word.level === 1 && word.reviewCount > 0}}">×{{word.reviewCount}}</text>
      </view>
      <block wx:if="{{displayMode === 'zh'}}">
        <view class="item-meaning item-meaning-main" wx:if="{{word.meaning}}">{{word.meaning}}</view>
        <view class="item-meaning" wx:else>（未填释义）</view>
      </block>
      <view class="item-meaning" wx:elif="{{displayMode === 'both' && word.meaning}}">{{word.meaning}}</view>
    </view>
    <view class="item-side">
      <view class="item-time" wx:if="{{word.timeText}}">{{word.timeText}}</view>
      <view class="tag" style="color: {{word.levelColor}}; background: {{word.levelBg}}">{{word.levelName}}</view>
    </view>
  </view>
</template>
