.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint {
  font-size: 24rpx;
  color: #969799;
  line-height: 1.6;
}

.example {
  background: #f7f8f9;
  border-radius: 8rpx;
  padding: 14rpx 20rpx;
  margin-top: 12rpx;
  color: #646566;
}

.import-area {
  width: 100%;
  box-sizing: border-box;
  min-height: 240rpx;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.parse-btn {
  margin: 28rpx 24rpx;
}

.preview-summary {
  font-size: 26rpx;
  color: #646566;
  margin-bottom: 20rpx;
}

.invalid-list {
  font-size: 24rpx;
  color: #ee0a24;
  margin-bottom: 16rpx;
}

.preview-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f1f2;
  font-size: 28rpx;
}

.preview-item.dup {
  color: #c8c9cc;
}

.preview-meaning {
  color: #969799;
  font-size: 24rpx;
  margin-left: 16rpx;
}

.preview-mark {
  margin-left: auto;
  font-size: 22rpx;
  color: #c8c9cc;
}

.hidden-tip {
  text-align: center;
  color: #c8c9cc;
  font-size: 24rpx;
  padding: 16rpx 0;
}

.import-btn {
  margin-top: 28rpx;
}
