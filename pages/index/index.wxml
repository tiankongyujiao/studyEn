<view class="page">
  <view class="card hero">
    <view class="hero-num">{{total}}</view>
    <view class="hero-label">总词汇量</view>
    <view class="hero-status" wx:if="{{!synced}}">{{hasLocal ? '云端同步中…' : '正在从云端加载…'}}</view>
  </view>

  <view class="seg">
    <view class="seg-item {{activeTab === 0 ? 'seg-on' : ''}}" data-tab="0" bindtap="onTabTap">掌握情况</view>
    <view class="seg-item {{activeTab === 1 ? 'seg-on' : ''}}" data-tab="1" bindtap="onTabTap">最近动态</view>
  </view>

  <block wx:if="{{activeTab === 0}}">
    <view class="card-list">
      <view class="card level-card" wx:for="{{levels}}" wx:key="id" hover-class="card-hover"
            data-level="{{item.id}}" bindtap="goList">
        <view class="level-row">
          <text class="level-name" style="color: {{item.color}}">{{item.name}}</text>
          <text class="level-count">{{counts[index]}}</text>
        </view>
        <view class="bar">
          <view class="bar-fill" style="width: {{percents[index]}}%; background: {{item.color}}"></view>
        </view>
        <view class="level-pct">{{percents[index]}}%</view>
      </view>
    </view>

    <view class="card empty-card" wx:if="{{synced && total === 0}}">
      还没有记录。点下面的「记单词」一个个加，或用「批量导入」把笔记本上的存量单词一次贴进来。
    </view>

    <view class="actions">
      <view class="btn btn-primary" bindtap="goAdd">记单词</view>
      <view class="btn btn-plain" bindtap="goImport">批量导入</view>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="recent-title">最近录入</view>
      <view class="recent-head">
        <view class="recent-cat"></view>
        <view class="recent-col">当天</view>
        <view class="recent-col">近一周</view>
        <view class="recent-col">近半月</view>
        <view class="recent-col">近一月</view>
      </view>
      <view class="recent-row" wx:for="{{recentRows}}" wx:key="id">
        <view class="recent-cat">
          <view class="dot" style="background: {{item.color}}"></view>
          <text>{{item.name}}</text>
        </view>
        <view class="recent-col recent-num">{{item.today}}</view>
        <view class="recent-col recent-num">{{item.week}}</view>
        <view class="recent-col recent-num">{{item.half}}</view>
        <view class="recent-col recent-num">{{item.month}}</view>
      </view>
    </view>

    <view class="card">
      <view class="recent-title">分类流动</view>
      <block wx:if="{{flowRows.length > 0}}">
        <view class="recent-head">
          <view class="recent-cat"></view>
          <view class="recent-col">当天</view>
          <view class="recent-col">近一周</view>
          <view class="recent-col">近半月</view>
          <view class="recent-col">近一月</view>
        </view>
        <view class="recent-row">
          <view class="recent-cat">
            <view class="dot" style="background: #07c160"></view>
            <text>晋级</text>
          </view>
          <view class="recent-col recent-num">{{flowUp[0]}}</view>
          <view class="recent-col recent-num">{{flowUp[1]}}</view>
          <view class="recent-col recent-num">{{flowUp[2]}}</view>
          <view class="recent-col recent-num">{{flowUp[3]}}</view>
        </view>
        <view class="recent-row">
          <view class="recent-cat">
            <view class="dot" style="background: #909399"></view>
            <text>退步</text>
          </view>
          <view class="recent-col recent-num">{{flowDown[0]}}</view>
          <view class="recent-col recent-num">{{flowDown[1]}}</view>
          <view class="recent-col recent-num">{{flowDown[2]}}</view>
          <view class="recent-col recent-num">{{flowDown[3]}}</view>
        </view>
        <view class="flow-divider"></view>
        <view class="recent-row" wx:for="{{flowRows}}" wx:key="key">
          <view class="recent-cat flow-names">
            <text>{{item.fromName}}</text>
            <text class="flow-arrow {{item.up ? 'flow-arrow-up' : 'flow-arrow-down'}}">→</text>
            <text>{{item.toName}}</text>
          </view>
          <view class="recent-col recent-num flow-num">{{item.counts[0]}}</view>
          <view class="recent-col recent-num flow-num">{{item.counts[1]}}</view>
          <view class="recent-col recent-num flow-num">{{item.counts[2]}}</view>
          <view class="recent-col recent-num flow-num">{{item.counts[3]}}</view>
        </view>
      </block>
      <view wx:else class="flow-empty">暂无分类移动记录，移动单词后开始积累</view>
    </view>
  </block>
</view>
