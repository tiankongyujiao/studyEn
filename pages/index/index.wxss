.hero {
  text-align: center;
  padding: 48rpx 28rpx;
}

.hero-num {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.1;
}

.hero-label {
  color: #969799;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.hero-status {
  color: #c8c9cc;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.recent-head,
.recent-row {
  display: flex;
  align-items: center;
}

.recent-head {
  color: #969799;
  font-size: 22rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f1f2;
}

.recent-row {
  padding: 16rpx 0;
  font-size: 26rpx;
}

.recent-row + .recent-row {
  border-top: 1rpx solid #f7f8f9;
}

.recent-cat {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.recent-col {
  width: 100rpx;
  text-align: center;
  flex-shrink: 0;
}

.recent-num {
  font-size: 30rpx;
  font-weight: 600;
}

.flow-divider {
  height: 1rpx;
  background: #f0f1f2;
  margin: 8rpx 0;
}

.flow-names {
  font-size: 24rpx;
}

.flow-arrow {
  margin: 0 8rpx;
  font-weight: 600;
}

.flow-arrow-up {
  color: #07c160;
}

.flow-arrow-down {
  color: #909399;
}

.flow-num {
  font-size: 28rpx;
}

.flow-empty {
  color: #c8c9cc;
  font-size: 24rpx;
  text-align: center;
  padding: 20rpx 0 4rpx;
}

.seg {
  display: flex;
  background: #fff;
  border-radius: 999rpx;
  margin: 20rpx 24rpx;
  padding: 8rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #646566;
  border-radius: 999rpx;
}

.seg-on {
  background: #323233;
  color: #fff;
  font-weight: 600;
}

.card-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 12rpx;
}

.level-card {
  width: calc(50% - 24rpx);
  margin: 12rpx;
  box-sizing: border-box;
}

.card-hover {
  opacity: 0.75;
}

.level-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.level-name {
  font-size: 28rpx;
  font-weight: 600;
}

.level-count {
  font-size: 40rpx;
  font-weight: 700;
}

.bar {
  height: 12rpx;
  background: #f0f1f2;
  border-radius: 999rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s;
}

.level-pct {
  font-size: 22rpx;
  color: #969799;
  margin-top: 8rpx;
  text-align: right;
}

.empty-card {
  color: #969799;
  font-size: 26rpx;
  line-height: 1.7;
}

.actions {
  margin: 40rpx 24rpx 60rpx;
}

.actions .btn + .btn {
  margin-top: 20rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.4);
  z-index: 100;
}

.fab:active {
  opacity: 0.85;
}
