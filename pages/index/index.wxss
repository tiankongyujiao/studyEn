.hero {
  text-align: center;
  padding: 48rpx 28rpx;
}

.hero-num {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.1;
}

.hero-label {
  color: #969799;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.hero-status {
  color: #c8c9cc;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.section-title {
  margin: 28rpx 32rpx 4rpx;
  font-size: 26rpx;
  color: #969799;
}

.card-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 12rpx;
}

.level-card {
  width: calc(50% - 12rpx);
  margin: 12rpx;
  box-sizing: border-box;
}

.card-hover {
  opacity: 0.75;
}

.level-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.level-name {
  font-size: 28rpx;
  font-weight: 600;
}

.level-count {
  font-size: 40rpx;
  font-weight: 700;
}

.bar {
  height: 12rpx;
  background: #f0f1f2;
  border-radius: 999rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s;
}

.level-pct {
  font-size: 22rpx;
  color: #969799;
  margin-top: 8rpx;
  text-align: right;
}

.empty-card {
  color: #969799;
  font-size: 26rpx;
  line-height: 1.7;
}

.actions {
  margin: 40rpx 24rpx 60rpx;
}

.actions .btn + .btn {
  margin-top: 20rpx;
}
